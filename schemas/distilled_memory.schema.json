{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neural-node-swarm.dev/schemas/distilled-memory.schema.json",
  "title": "Distilled Memory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "memory_version", "source_event_ids", "patterns", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0"}, "memory_version": {"type": "integer", "minimum": 0}, "source_event_ids": {"type": "array", "items": {"type": "string"}}, "patterns": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["key", "sample_size", "pass_rate"], "properties": {"key": {"type": "string", "minLength": 1}, "sample_size": {"type": "integer", "minimum": 1}, "pass_rate": {"type": "number", "minimum": 0, "maximum": 1}, "failure_count": {"type": "integer", "minimum": 0}}}}, "updated_at": {"type": "string", "format": "date-time"}
  }
}
